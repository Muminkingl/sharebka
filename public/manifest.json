{
    "name": "ShareBka",
    "short_name": "ShareBka",
    "icons": [
        {
            "src": "trx.svg",
            "sizes": "any",
            "type": "image/svg+xml"
        }
    ],
    "background_color": "#efefef",
    "start_url": "./",
    "display": "standalone",
    "theme_color": "#3367d6",
    "share_target": {
        "action": "/",
        "method": "POST",
        "enctype": "multipart/form-data",
        "params": {
            "title": "title",
            "text": "text",
            "url": "url",
            "files": [
                {
                    "name": "allfiles",
                    "accept": [
                        "*/*"
                    ]
                }
            ]
        }
    },
    "launch_handler": {
        "client_mode": "focus-existing"
    },
    "description": "Share files and messages privately across your devices with ShareBka."
}
